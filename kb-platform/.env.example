# ==== 应用 ====
APP_ENV=local
APP_NAME=kb-platform
DEBUG=true
SECRET_KEY=dev-secret-key-change-me

# ==== PostgreSQL ====
DATABASE_URL=postgresql+asyncpg://kbplatform:kbplatform@localhost:5432/kbplatform

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== Qdrant ====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=kb_

# ==== MinIO / 对象存储 ====
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=kbplatform
OBJECT_STORAGE_SECRET_KEY=kbplatform123
OBJECT_STORAGE_BUCKET=kb-platform-docs
OBJECT_STORAGE_SECURE=false

# ==== LLM / Embedding ====
# 需要接入真实模型时，填入 OpenAI 兼容的 Key/Base URL（例如 DeepSeek），无需改代码。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
